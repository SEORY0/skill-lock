{
  "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "test/**", "*.json"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "preset": "recommended",
    "rules": {
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  }
}
